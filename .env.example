# ============================================================
# Li-OCR R1.0 环境变量样例
# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交
# ============================================================

# --- 服务 ---
LIOCR_HOST=127.0.0.1
LIOCR_PORT=8080
# 访问口令（留空=不校验，仅限本机）；生产必须设置为强随机串
LIOCR_API_TOKEN=
# 允许的跨域来源，逗号分隔；留空=同源
LIOCR_CORS_ORIGINS=

# --- 存储（默认在仓库外，避免误提交） ---
LIOCR_DATA_DIR=./data
LIOCR_DB_PATH=./data/liocr.sqlite3

# --- OCR 引擎 ---
# gpu:0 / cpu
LIOCR_DEVICE=gpu:0
# mobile=快（约0.8s/页） server=准（约1.2s/页）
LIOCR_OCR_MODEL=mobile
# 单进程内 OCR 工作线程数；8GB 显存建议 1
LIOCR_WORKERS=1
# 页面渲染 DPI
LIOCR_RENDER_DPI=200
# 是否启用 CPU 旁路交叉验证（RapidOCR），auto=安装则启用
LIOCR_CROSSCHECK=auto
# 手写/低质量页是否用 PaddleOCR-VL 兜底：auto=GPU 可用时启用，off=关闭
# 代价：单页 12~40s、常驻约 7.9GB 显存（用完即卸），仅在页面质量门触发时调用
LIOCR_VL_FALLBACK=auto
# 低置信阈值（低于即判可疑）
LIOCR_CONF_THRESHOLD=0.90
LIOCR_CONF_THRESHOLD_AMOUNT=0.95

# --- 进程内鉴权/审计（可选） ---
LIOCR_ENV=dev
